<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">
<com.google.android.material.button.MaterialButton
    android:id="@+id/word_insert"
    style="@style/Widget.Material3.Button.TextButton"
    android:layout_width="40dp"
    android:layout_height="72dp"
    android:insetLeft="0dp"
    android:insetRight="0dp"
    android:insetTop="0dp"
    android:insetBottom="0dp"
    android:minWidth="0dp"
    android:minHeight="0dp"
    android:padding="0dp"
    android:lineSpacingMultiplier="0.8"
    android:text="+&#10;·"
    android:textSize="18sp"
    android:contentDescription="Insert a separator before this card" />
<com.google.android.material.card.MaterialCardView
    android:id="@+id/word_card"
    android:layout_width="148dp"
    android:layout_height="wrap_content"
    android:clickable="true"
    android:focusable="true"
    app:cardBackgroundColor="?attr/colorSurface"
    app:cardCornerRadius="16dp"
    app:strokeColor="?attr/colorPrimary"
    app:strokeWidth="1dp">
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="8dp">
        <TextView
            android:id="@+id/word_drag"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:contentDescription="Drag to reorder"
            android:gravity="center"
            android:text="⠿"
            android:textSize="20sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />
        <TextView
            android:id="@+id/word_label"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceTitleMedium"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/word_drag"
            app:layout_constraintTop_toTopOf="parent" />
        <TextView
            android:id="@+id/word_greek"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceBodyMedium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/word_drag"
            app:layout_constraintTop_toBottomOf="@id/word_label" />
        <TextView
            android:id="@+id/word_position"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/word_greek" />
        <com.google.android.material.chip.Chip
            android:id="@+id/word_metadata"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:clickable="false"
            android:textAppearance="?attr/textAppearanceLabelSmall"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/word_position" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/word_play_existing"
            style="@style/Widget.Material3.Button.TonalButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            android:contentDescription="Play existing recording"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/word_metadata" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/word_play"
            style="@style/Widget.Material3.Button"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:insetTop="0dp"
            android:insetBottom="0dp"
            app:icon="@android:drawable/ic_media_play"
            app:iconGravity="textStart"
            app:iconPadding="0dp"
            app:layout_constraintStart_toEndOf="@id/word_play_existing"
            app:layout_constraintTop_toBottomOf="@id/word_metadata" />
        <com.google.android.material.button.MaterialButton
            android:id="@+id/word_assign"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="40dp"
            android:layout_height="40dp"
            android:minWidth="0dp"
            android:padding="0dp"
            android:text="✓"
            android:textSize="20sp"
            android:contentDescription="Save selected clip and next"
            app:layout_constraintStart_toEndOf="@id/word_play"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/word_play"
            app:layout_constraintBottom_toBottomOf="@id/word_play" />
    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>
</LinearLayout>
